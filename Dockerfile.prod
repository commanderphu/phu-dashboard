# ============================================================
# Produktionsabbild: bauen mit Node, ausliefern mit nginx
# ============================================================
# Der Entwicklungsbetrieb läuft weiter über das normale Dockerfile mit
# "pnpm dev --host". Hier entsteht ein statisches Artefakt — kein Vite zur
# Laufzeit, keine Quellkarten, kein HMR-Websocket.

# ---------- Stufe 1: bauen ----------
FROM node:22-alpine AS builder
WORKDIR /build

# Abhängigkeiten zuerst, damit diese Schicht im Cache bleibt, solange sich
# package.json nicht ändert.
COPY package.json package-lock.json* pnpm-lock.yaml* ./
RUN if [ -f pnpm-lock.yaml ]; then \
      corepack enable && pnpm install --frozen-lockfile; \
    else \
      npm ci || npm install; \
    fi

COPY . .

# VITE_API_URL wird hier NICHT gesetzt: die Adresse kommt zur Laufzeit aus
# window.__APP_CONFIG__ (siehe entrypoint.sh). So ist dasselbe Abbild in
# jeder Umgebung verwendbar.
RUN npm run build

# ---------- Stufe 2: ausliefern ----------
FROM nginx:alpine AS runtime

COPY --from=builder /build/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/entrypoint.sh /docker-entrypoint.d/40-app-config.sh
RUN chmod +x /docker-entrypoint.d/40-app-config.sh

# Adresse des phu-api-hub — beim Start überschreibbar:
#   docker run -e API_URL=https://api.example.org ...
ENV API_URL=""

EXPOSE 80
