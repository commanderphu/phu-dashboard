# =====================================
# 🌐 PHU DASHBOARD ENVIRONMENT CONFIG
# =====================================
# Kopiere diese Datei als .env und trage deine Werte ein.
# NIEMALS die echte .env committen!

# Node/Vite Umgebung
NODE_ENV=development
HOST=0.0.0.0
PORT=5173
PREVIEW_PORT=4173

# Netzwerk
NETWORK=core_network

# Dashboard Name & Version
APP_NAME=phu-dashboard
APP_VERSION=0.3.0

# App-spezifische Variablen
VITE_APP_TITLE="Phu's Nerd Dashboard"
VITE_API_URL=https://api.intern.phudevelopement.xyz

# Spätere interne Verbindungen (Postgres, PocketBase etc.)
# DB_HOST=postgres.intern.phudevelopment.xyz
# DB_PORT=5432
# PB_URL=http://pocketbase.intern.phudevelopment.xyz

# SPOTIFY INTEGRATION
# Client ID aus: https://developer.spotify.com/dashboard
# Das Client Secret gehört NICHT hierher (VITE_-Variablen landen im Browser-
# Bundle) — es steht serverseitig im phu-api-hub als SPOTIFY_CLIENT_SECRET.
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
VITE_SPOTIFY_REDIRECT_URI=https://dashboard.intern.phudevelopement.xyz/callback
